{
  "info": {
    "name": "PTM-06 IMWAD — Visitor Prediction API (Auth, CRUD, AI)",
    "description": "Koleksi uji API backend PTM-06 untuk Sistem Prediksi Jumlah Pengunjung Wisata Religi Makam Gus Dur.\n\nMencakup alur sukses (200/201/204) dan alur kegagalan (401/403/404/409/413/415/422).\n\nCARA PAKAI:\n1. Jalankan backend: uvicorn app.main:app --reload --port 8000\n2. Import koleksi ini ke Postman.\n3. Jalankan folder '01 - Authentication' lebih dulu; token tersimpan otomatis ke variable koleksi.\n4. Untuk menguji celah BOLA, jalankan folder '06 - BOLA Security' — semua request di sana HARUS mengembalikan 403.\n5. Alternatif: gunakan Collection Runner untuk menjalankan seluruh folder secara berurutan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "access_token_b", "value": "", "type": "string" },
    { "key": "history_id", "value": "", "type": "string" },
    { "key": "prediction_id", "value": "", "type": "string" },
    { "key": "unique_date", "value": "2025-06-01", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 - System Health",
      "item": [
        {
          "name": "GET /health — status aplikasi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('info model terlaporkan', () => pm.expect(pm.response.json()).to.have.property('model_loaded'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Health check. Tidak memerlukan token."
          }
        },
        {
          "name": "GET / — info API",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] },
            "description": "Informasi singkat API dan tautan dokumentasi."
          }
        }
      ]
    },
    {
      "name": "01 - Authentication (happy path)",
      "item": [
        {
          "name": "POST /auth/signup — registrasi pengguna A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('access_token diterima', () => pm.expect(b.access_token).to.be.a('string').and.not.empty);",
                  "pm.test('refresh_token diterima', () => pm.expect(b.refresh_token).to.be.a('string').and.not.empty);",
                  "pm.test('expires_in = 1800 detik', () => pm.expect(b.expires_in).to.eql(1800));",
                  "pm.collectionVariables.set('access_token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pengelola Wisata\",\n  \"email\": \"pengelola@example.com\",\n  \"password\": \"Rahasia123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/signup", "host": ["{{base_url}}"], "path": ["auth", "signup"] },
            "description": "Registrasi pengguna. Token hasil respons disimpan otomatis ke variable koleksi. Bila dijalankan ulang, akan mengembalikan 409 (sudah terdaftar) — itu perilaku yang benar."
          }
        },
        {
          "name": "POST /auth/login — login pengguna A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('token pair lengkap', () => {",
                  "  pm.expect(b.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('access_token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pengelola@example.com\",\n  \"password\": \"Rahasia123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "description": "Login dan simpan token pair."
          }
        },
        {
          "name": "GET /auth/me — profil terproteksi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('email sesuai', () => pm.expect(b.email).to.eql('pengelola@example.com'));",
                  "pm.test('password hash TIDAK bocor', () => pm.expect(b).to.not.have.property('hashed_password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] },
            "description": "Memerlukan Authorization: Bearer {{access_token}} (diwarisi dari auth koleksi)."
          }
        },
        {
          "name": "POST /auth/refresh — perbarui access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('access_token baru diterima', () => pm.expect(b.access_token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('access_token', b.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "description": "Terbitkan access token baru dari refresh token."
          }
        }
      ]
    },
