# ==============================================================================
# .env.example — Template variabel lingkungan backend PTM-06
# Salin menjadi `.env` lalu isi nilainya. JANGAN commit file `.env` yang berisi
# nilai rahasia riil ke repositori.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# SQLite untuk pengembangan lokal (default).
DATABASE_URL=sqlite:///./app.db

# Contoh PostgreSQL untuk produksi (butuh driver psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/imwad_ptm06

# --- JWT / Keamanan -----------------------------------------------------------
# WAJIB diganti dengan nilai acak yang kuat pada lingkungan nyata.
# Bangkitkan dengan: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-long-random-secret-key
ALGORITHM=HS256

# Masa berlaku token (menit). Access token pendek, refresh token panjang.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Model AI (XGBoost) -------------------------------------------------------
# Path artefak model & scaler. Jika file tidak ada, service memakai mode MOCK
# deterministik agar backend tetap dapat dijalankan dan diuji.
MODEL_PATH=ml/model_xgb.json
SCALER_PATH=ml/scaler.pkl

# --- Batas Sumber Daya (OWASP API4:2023) --------------------------------------
MAX_FILE_SIZE_MB=5

# --- CORS ---------------------------------------------------------------------
# Pisahkan dengan koma. Gunakan * hanya untuk pengembangan lokal.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
