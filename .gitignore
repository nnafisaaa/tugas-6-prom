# ==============================================================================
# .gitignore — Backend PTM-06
# ==============================================================================

# Environment & secret
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Database lokal
*.db
*.sqlite
*.sqlite3

# Artefak model AI (dibangkitkan dari proses training, tidak di-commit)
ml/*.json
ml/*.pkl
ml/*.joblib

# Log & OS
*.log
.DS_Store
Thumbs.db
